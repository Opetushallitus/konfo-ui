{
  "name": "konfo-ui",
  "version": "0.1.0",
  "homepage": "/konfo",
  "private": true,
  "scripts": {
    "prepare": "cd ../../../ && husky",
    "start": "vite dev",
    "build": "vite build",
    "preview:watch": "vite build --watch & pnpm run serve:test",
    "test": "cross-env NODE_ENV=test vitest",
    "serve:test": "node test-server.js",
    "test:integration": "start-server-and-test \"pnpm run serve:test\" http://localhost:3005/konfo \"pnpm run playwright\"",
    "test:ci": "cross-env CI=true pnpm run test && cross-env CI=true pnpm run test:integration",
    "playwright": "playwright test",
    "playwright:ui": "playwright test --ui",
    "lint": "eslint ./src ./playwright --max-warnings 0",
    "lint:fix": "pnpm run lint -- --fix",
    "analyze": "vite-bundle-visualizer",
    "tsc": "tsc",
    "cf-content-types": "cf-content-types-generator -s $CONTENTFUL_SPACE_ID -t $CONTENTFUL_MANAGEMENT_API_TOKEN -e $CONTENTFUL_ENVIRONMENT_ID -o ./src/types/contentful",
    "contentful:typegen": "dotenv -e .env.local -- pnpm run cf-content-types",
    "konfo-backend:typegen": "npx openapi-typescript http://localhost:3006/konfo-backend/swagger.yaml -o ./src/types/konfo-backend.d.ts"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^7.3.11",
    "@mui/material": "^7.3.11",
    "@mui/system": "^7.3.11",
    "@mui/utils": "^7.3.11",
    "@opetushallitus/oph-design-system": "^2.0.0",
    "@reduxjs/toolkit": "^2.13.0",
    "@tanstack/react-query": "^5.105.1",
    "@tanstack/react-query-devtools": "^5.105.1",
    "axios": "^1.21.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "dompurify": "^3.4.17",
    "html-react-parser": "^6.1.9",
    "i18next": "^26.7.1",
    "i18next-http-backend": "^4.0.9",
    "immer": "^11.2.9",
    "js-cookie": "^3.0.8",
    "lodash-es": "^4.18.1",
    "markdown-to-jsx": "^9.10.4",
    "oph-urls-js": "github:Opetushallitus/oph-urls-js#9fc4edaa04c10fa974f124b5c228c41c2c6f0bc5",
    "oskari-rpc": "^2.1.0",
    "query-string": "^9.5.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-error-boundary": "^6.1.6",
    "react-i18next": "^17.1.11",
    "react-inlinesvg": "^4.5.0",
    "react-player": "^3.4.0",
    "react-redux": "^9.3.1",
    "react-router-dom": "^7.18.5",
    "react-select": "^5.10.2",
    "react-transition-group": "^4.4.5",
    "react-truncate-markup": "^5.1.2",
    "react-use": "^17.6.1",
    "redux": "^5.0.1",
    "remove-markdown": "^0.6.4",
    "stacktrace-js": "^2.0.2",
    "ts-pattern": "^5.9.2",
    "tslib": "^2.9.1",
    "tss-react": "^4.9.21",
    "typeface-open-sans": "^1.1.13",
    "victory": "^37.4.1",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint-react/eslint-plugin": "^5.28.8",
    "@eslint/js": "^10.0.1",
    "@material-design-icons/svg": "^0.14.15",
    "@playwright/test": "^1.64.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/js-cookie": "^3.0.6",
    "@types/lodash": "^4.17.27",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/react-redux": "^7.1.35",
    "@types/react-router-dom": "^5.3.3",
    "@types/react-transition-group": "^4.4.12",
    "@types/testing-library__jest-dom": "^6.0.0",
    "@vitejs/plugin-react": "^6.2.1",
    "browserslist-to-esbuild": "^2.1.1",
    "cf-content-types-generator": "^3.0.1",
    "contentful": "^11.12.10",
    "cross-env": "^10.1.0",
    "dotenv-cli": "^11.1.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-lodash-es": "^1.2.1",
    "eslint-plugin-playwright": "^2.12.2",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-react-refresh": "^0.5.7",
    "express": "^5.3.0",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "jsdom": "^30.1.3",
    "lint-staged": "^17.6.0",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.10",
    "start-server-and-test": "^3.0.13",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vite-bundle-visualizer": "^1.2.1",
    "vite-plugin-checker": "^0.14.5",
    "vite-plugin-dynamic-import": "^1.6.0",
    "vite-plugin-static-copy": "^4.1.1",
    "vite-plugin-svgr": "^5.2.0",
    "vitest": "^5.0.5"
  },
  "lint-staged": {
    "*.{json,css,md}": [
      "prettier --write"
    ],
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not ie 11",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^12.0.0",
      "onFail": "error"
    }
  }
}
